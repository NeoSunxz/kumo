#!/bin/sh
# 校验提交信息是否符合 CONTRIBUTING.md 的 Conventional Commits 规范
# 用法: commit-msg <提交信息文件>
# 长度按 UTF-8 字符计数 (去掉续字节 0x80-0xBF), 与当前 locale 无关

file=$1

# 去掉 CR, 截掉 git commit -v 的剪刀线及之后内容, 去掉注释行, 跳过首部空行
msg=$(tr -d '\r' < "$file" \
  | sed '/^# -\{24\} >8 -\{24\}$/,$d' \
  | grep -v '^#' \
  | awk 'NF || started { started = 1; print }')
# 信息为空交给 git 自己中止
[ -z "$msg" ] && exit 0
first=$(printf '%s\n' "$msg" | sed -n 1p)
second=$(printf '%s\n' "$msg" | sed -n 2p)
lines=$(printf '%s\n' "$msg" | wc -l)

# 放行: 合并 / 回退 / 自动整理提交
case $first in
  "Merge "* | 'Revert "'* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

errors=""
add() { errors="$errors
  - $1"; }

pattern='^(feat|fix|refactor|perf|style|test|docs|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^[:space:]]'
if ! printf '%s\n' "$first" | LC_ALL=C grep -Eq "$pattern"; then
  add "首行必须是 <type>(<scope>): <描述>, type 为小写英文, 冒号后有一个空格"
fi

len=$(printf '%s' "$first" | LC_ALL=C tr -d '\200-\277' | LC_ALL=C wc -c | tr -d ' ')
if [ "$len" -gt 72 ]; then
  add "首行最多 72 个字符 (中文算 1 个), 当前 $len 个"
fi

trimmed=$(printf '%s' "$first" | sed 's/[[:space:]]*$//')
last=$(printf '%s' "$trimmed" | LC_ALL=C tail -c 3)
case $last in
  "。") add "首行结尾不能加句号 (。)" ;;
  *.) add "首行结尾不能加句号 (.)" ;;
esac

if [ "$lines" -gt 1 ] && [ -n "$second" ]; then
  add "首行后必须空一行, 再写正文"
fi

[ -z "$errors" ] && exit 0

cat >&2 <<MSG
提交信息不符合规范:$errors

格式: <type>(<scope>): <描述>
  空行
  正文 (可选)
示例:
  feat(web): 订阅页支持批量删除
  fix: 修正空串导致 422
  feat(api)!: 去掉 RSS 输出
type: feat fix refactor perf style test docs build ci chore revert
详见 CONTRIBUTING.md
MSG
exit 1
